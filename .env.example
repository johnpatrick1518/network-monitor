# Empty means auto-detect an active private IPv4 interface.
DEMO_MODE=false
# Used instead of DATABASE_URL in demo mode; keep separate from live inventory.
DEMO_DATABASE_URL=sqlite:///./data/demo.db
SUBNET=
SCAN_INTERVAL_SECONDS=300
PING_INTERVAL_SECONDS=60
PING_TIMEOUT_SECONDS=2
PING_WORKERS=32
DOWN_THRESHOLD=3
ALERT_COOLDOWN_SECONDS=3600
HISTORY_RETENTION_DAYS=30
DATABASE_URL=sqlite:///./data/network-monitor.db
DASHBOARD_USERNAME=admin
# REQUIRED: replace before starting. Do not expose this app to the Internet.
DASHBOARD_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
LOG_LEVEL=INFO
